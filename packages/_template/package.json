{
  "name": "@gusm/_template",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt -c ../oxc-config/oxfmtrc.json .",
    "format:check": "oxfmt -c ../oxc-config/oxfmtrc.json --check .",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@gusm/oxc-config": "workspace:*",
    "@gusm/typescript-config": "workspace:*",
    "@types/node": "^20",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^5"
  }
}
