{
  "name": "@gusm/utils",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    "./date": "./src/date.ts",
    "./math": "./src/math.ts",
    "./link": "./src/link.ts"
  },
  "scripts": {
